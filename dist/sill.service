# sill, the shell, as a systemd user service.
#
# Install: copy to ~/.config/systemd/user/sill.service (adjust ExecStart if sill is not in
# /usr/bin), then `systemctl --user enable --now sill.service` inside a casement session.
# `sill run` takes a single-instance lock (latchkey) and exits 0 when one is already running,
# so a client that started the daemon on demand and this unit never race into two shells.
[Unit]
Description=sill, the shell (bar, wallpaper, dock, launcher)
Documentation=https://github.com/PoHsuanLai/sill
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/sill run
Restart=on-failure
RestartSec=1
# The shell draws on the user's session compositor; nothing here needs more than the user.
NoNewPrivileges=yes

[Install]
WantedBy=graphical-session.target
