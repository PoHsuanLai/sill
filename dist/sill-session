#!/bin/sh
# sill-session: a real login with sill as the shell on COSMIC's compositor. DOCUMENTED, NOT
# INSTALLED by anything (sill FINDINGS "M7"; docs/manual-checks.md "Needs a sill login").
#
# Why a script of our own: cosmic-session hard-codes its component list (panel, launcher,
# app library, workspaces, osd, bg, greeter, files applet, idle, notifications) and restarts each
# one forever, so it cannot be told to run sill instead (plan "Findings: COSMIC").
#
# Install (as root), then pick "COSMIC (sill)" at the login screen:
#   install -m 755 dist/sill-session           /usr/local/bin/sill-session
#   install -m 644 dist/sill.desktop           /usr/share/wayland-sessions/sill.desktop
#   install -m 644 dist/sill-session.target    /usr/lib/systemd/user/sill-session.target
#
# Two stages. Outside (run by the display manager): set the environment and exec cosmic-comp
# with this script as its kiosk command. Inside (the kiosk child, `--inside`): start and
# supervise every component. cosmic-comp exits when its kiosk child exits, so the inside stage
# never exits on its own: logging out (sill's power menu, `loginctl terminate-session`) ends
# the whole logind session, compositor included.
#
# What runs inside, and why each:
#   sill run                  bar, wallpaper, dock, launcher, control center, power menu (the
#                             logout dialog), OSD, notifications (so cosmic-notifications must
#                             NOT run), and the lock screen (session.locker, M7)
#   cosmic-settings-daemon    theme, brightness and power keys COSMIC's own config expects;
#                             it also runs the shortcuts' system actions (dist/cosmic)
#   xdg-desktop-portal-cosmic the settings portal quire reads (colour scheme, reduced motion),
#                             screenshots and file choosers
#   cosmic-idle               screen off after the idle time, then `loginctl lock-session`
#                             (which sill's locker answers), and suspend on idle
#   sill polkit-agent         the polkit agent session.polkit_agent names (auto: KDE's, GNOME's,
#                             LXQt's, MATE's, else cosmic-osd)
#   systemd-inhibit           holds logind's handle-power-key, as cosmic-session does, so the
#                             power key opens sill's power menu instead of powering off
# Left out on purpose: cosmic-panel, cosmic-launcher, cosmic-app-library, cosmic-bg,
# cosmic-notifications and cosmic-osd (sill replaces them; cosmic-osd would double sill's
# volume indicator), cosmic-workspaces and cosmic-files-applet (not used by sill yet), and
# cosmic-greeter (sill starts it per lock). docs/cosmic-gaps.md lists what else cosmic-session
# did.
set -eu

if [ "${1:-}" != "--inside" ]; then
    # Outside: a login shell once, so ~/.profile's PATH (sill in ~/.cargo/bin, say) applies.
    if [ -n "${SHELL:-}" ] && [ "${1:-}" != "--in-login-shell" ]; then
        exec "$SHELL" -l -c "exec '$0' --in-login-shell"
    fi
    export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-COSMIC}"
    export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-COSMIC}"
    export XDG_SESSION_TYPE=wayland
    export MOZ_ENABLE_WAYLAND=1
    export QT_QPA_PLATFORM="wayland;xcb"
    export GDK_BACKEND="wayland,x11"
    exec cosmic-comp "$0" --inside
fi

# Inside: cosmic-comp has set WAYLAND_DISPLAY (and DISPLAY with Xwayland) for us.
log() { printf 'sill-session: %s\n' "$*" >&2; }

# Restart a component when it exits; give up after five exits within ten seconds each, so a
# component that cannot start does not spin.
respawn() {
    name="$1"
    shift
    (
        quick=0
        while [ "$quick" -lt 5 ]; do
            started=$(date +%s)
            "$@" || log "$name exited with $?"
            if [ $(($(date +%s) - started)) -lt 10 ]; then
                quick=$((quick + 1))
            else
                quick=0
            fi
            sleep 1
        done
        log "$name keeps exiting; not restarting it"
    ) &
}

# The environment D-Bus activation and systemd user units see (portals, sill.service).
dbus-update-activation-environment --systemd \
    WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_DESKTOP XDG_SESSION_TYPE \
    MOZ_ENABLE_WAYLAND QT_QPA_PLATFORM GDK_BACKEND 2>/dev/null ||
    log "could not update the activation environment"

# graphical-session.target (and XDG autostart) through our own target, as cosmic-session.target
# does for COSMIC. Stopped again when this script is told to end.
if command -v systemctl >/dev/null; then
    systemctl --user start sill-session.target || log "sill-session.target did not start"
    trap 'systemctl --user stop sill-session.target; exit 0' TERM INT HUP
fi

respawn power-key systemd-inhibit --what=handle-power-key --who=sill-session \
    --why="the power key opens sill's power menu" --mode=block sleep infinity
respawn settings-daemon cosmic-settings-daemon
respawn portal /usr/libexec/xdg-desktop-portal-cosmic
respawn idle cosmic-idle
respawn polkit-agent sill polkit-agent
respawn sill sill run

# Never return: this script's exit would end the compositor.
while :; do
    wait || true
    sleep 60
done
