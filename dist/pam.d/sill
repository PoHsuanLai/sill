#%PAM-1.0
# sill's own lock screen (`session.locker = "sill"`): the password check `sill auth-check` runs.
# Install as /etc/pam.d/sill; without it sill falls back to the `login` service. The same
# shape as swaylock's own file: the login stack decides which modules run.
auth     include  login
account  include  login
